+    /** 监听服务回传的巡航进度，用于地图与状态同步 */
+    private void initRouteReceiver() {
+        mRouteReceiver = new BroadcastReceiver() {
+            @Override
+            public void onReceive(Context context, Intent intent) {
+                if (!ServiceGo.ACTION_ROUTE_PROGRESS.equals(intent.getAction())) {
+                    return;
+                }
+                double lng = intent.getDoubleExtra(ServiceGo.EXTRA_ROUTE_LNG, 0.0);
+                double lat = intent.getDoubleExtra(ServiceGo.EXTRA_ROUTE_LAT, 0.0);
+                float speed = (float) intent.getDoubleExtra(ServiceGo.EXTRA_ROUTE_SPEED, 0.0);
+                float bearing = (float) intent.getDoubleExtra(ServiceGo.EXTRA_ROUTE_BEARING, 0.0);
+                double progress = intent.getDoubleExtra(ServiceGo.EXTRA_ROUTE_PROGRESS, 0.0);
+                int lap = intent.getIntExtra(ServiceGo.EXTRA_ROUTE_LAP, 1);
+                boolean finished = intent.getBooleanExtra(ServiceGo.EXTRA_ROUTE_FINISHED, false);
+
+                double[] bd = MapUtils.wgs2bd09(lng, lat);
+
+                if (mBaiduMap != null) {
+                    MyLocationData locData = new MyLocationData.Builder()
+                            .accuracy(6.0f)
+                            .direction(bearing)
+                            .latitude(bd[1])
+                            .longitude(bd[0])
+                            .build();
+                    mBaiduMap.setMyLocationData(locData);
+                }
+
+                if (mRouteStatus != null && mRoutePanel.getVisibility() == View.VISIBLE) {
+                    mRouteStatus.setText(getString(R.string.route_running_fmt, speed, progress * 100.0, Math.max(1, lap)));
+                }
+
+                if (finished) {
+                    isRoutePlaying = false;
+                    isRoutePaused = false;
+                    mRouteBtnPause.setText(R.string.route_btn_pause);
+                    updateRouteStatus();
+                    GoUtils.DisplayToast(MainActivity.this, getResources().getString(R.string.route_finished));
+                }
+            }
+        };
+        registerReceiver(mRouteReceiver, new IntentFilter(ServiceGo.ACTION_ROUTE_PROGRESS));
+    }
+
