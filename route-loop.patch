+     */
+    private void drawRoute() {
+        if (mBaiduMap == null) {
+            return;
+        }
+        try {
+            for (Marker m : mRouteMarkers) {
+                if (m != null && !m.isRemoved()) {
+                    m.remove();
+                }
+            }
+            mRouteMarkers.clear();
+
+            int total = mRoutePoints.size();
+            for (int i = 0; i < total; i++) {
+                MarkerOptions mo = new MarkerOptions()
+                        .position(mRoutePoints.get(i))
+                        .icon(routeDotIcon(i, total))
+                        .anchor(0.5f, 0.5f)
+                        .draggable(true);
+                Overlay overlay = mBaiduMap.addOverlay(mo);
+                if (overlay instanceof Marker) {
+                    mRouteMarkers.add((Marker) overlay);
+                }
+            }
+
+            if (total < 2) {
+                if (mRouteLine != null) {
+                    mRouteLine.remove();
+                    mRouteLine = null;
+                }
+                return;
+            }
+
+            List<LatLng> pts = new ArrayList<>(mRoutePoints);
+            if (mRouteLine == null) {
