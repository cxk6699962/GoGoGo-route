+        }
+
+        double lapOffset = 1.2;
+        double drift = 0.25;
+        try {
+            lapOffset = Double.parseDouble(sharedPreferences.getString("setting_loop_offset", "1.2"));
+        } catch (Exception ignored) {
+        }
+        try {
+            drift = Double.parseDouble(sharedPreferences.getString("setting_drift", "0.25"));
+        } catch (Exception ignored) {
+        }
+        lapOffset = Math.max(0.0, Math.min(10.0, lapOffset));
+        drift = Math.max(0.0, Math.min(5.0, drift));
+
+        // 步频驱动需要 ACTIVITY_RECOGNITION 权限（Android 10+）
+        if (sharedPreferences.getBoolean("setting_step_drive", false)
+                && android.os.Build.VERSION.SDK_INT >= android.os.Build.VERSION_CODES.Q
+                && checkSelfPermission(android.Manifest.permission.ACTIVITY_RECOGNITION)
+                != android.content.pm.PackageManager.PERMISSION_GRANTED) {
+            requestPermissions(new String[] {android.Manifest.permission.ACTIVITY_RECOGNITION}, 1001);
+        }
+
+        int mode = RoutePlayer.MODE_LOOP;
+        if (mRoutePingPong.isChecked()) {
+            mode = RoutePlayer.MODE_PINGPONG;
+        } else if (!mRouteLoop.isChecked()) {
+            mode = RoutePlayer.MODE_ONCE;
+        }
+
+        double alt = 55.0;
+        try {
+            alt = Double.parseDouble(sharedPreferences.getString("setting_altitude", "55.0"));
+        } catch (Exception ignored) {
+        }
+
+        // 防瞬移：当前位置离起点较远时，先把当前位置插入为第 0 点，
+        // 否则一开跑就会从真实/上次位置瞬间跳到起点，看起来像"乱跑"
+        if (mCurrentLat != 0.0 && mCurrentLon != 0.0) {
+            LatLng cur = new LatLng(mCurrentLat, mCurrentLon);
+            if (distanceMeterBd(cur, mRoutePoints.get(0)) > 30.0) {
+                mRoutePoints.add(0, cur);
+                sanitizeRoute();
+                persistRoute();
+                drawRoute();
+                updateRouteStatus();
+                GoUtils.DisplayToast(this, getResources().getString(R.string.route_insert_current));
+            }
+        }
+
+        List<double[]> wgs = new ArrayList<>();
+        for (LatLng p : mRoutePoints) {
+            double[] w = MapUtils.bd2wgs(p.longitude, p.latitude);
+            wgs.add(new double[] {w[0], w[1], alt, 0.0});
+        }
+
+        mPendingWgs = wgs;
+        mPendingMode = mode;
+        mPendingSpeed = speed;
+        mPendingAccel = accel;
+        mPendingTerrain = terrain;
+        mPendingTerrainPeriod = terrainPeriod;
+        mPendingLapOffset = lapOffset;
+        mPendingDrift = drift;
+
+        sharedPreferences.edit()
+                .putString("setting_route_speed", String.valueOf(speed))
+                .apply();
+
+        if (!isMockServStart) {
+            mMarkLatLngMap = mRoutePoints.get(0);
+            startGoLocation();
+            mButtonStart.setImageResource(R.drawable.ic_fly);
+            if (GoUtils.isWifiEnabled(this)) {
+                GoUtils.showDisableWifiDialog(MainActivity.this);
+            }
+        }
+
+        isRoutePlaying = true;
+        isRoutePaused = false;
+        mRouteBtnPause.setText(R.string.route_btn_pause);
+
+        if (mServiceBinder != null) {
+            applyRouteStart();
+        } else {
+            mPendingRouteStart = true;
+        }
+
+        GoUtils.DisplayToast(this, getResources().getString(R.string.route_started));
+    }
+
+    private void applyRouteStart() {
+        if (mServiceBinder == null || mPendingWgs == null) {
+            return;
+        }
+        boolean ok = mServiceBinder.startRoute(mPendingWgs, mPendingMode, mPendingSpeed,
+                mPendingAccel, mPendingTerrain, mPendingTerrainPeriod,
+                mPendingLapOffset, mPendingDrift);
+        if (!ok) {
+            isRoutePlaying = false;
+            GoUtils.DisplayToast(this, getResources().getString(R.string.route_need_points));
+        }
+    }
+
+    private void stopRouteCruise(boolean showToast) {
+        if (mServiceBinder != null) {
+            mServiceBinder.stopRoute();
+        }
+        isRoutePlaying = false;
+        isRoutePaused = false;
+        mRouteBtnPause.setText(R.string.route_btn_pause);
+        if (showToast) {
+            GoUtils.DisplayToast(this, getResources().getString(R.string.route_stopped));
+        }
+    }
+
 }
