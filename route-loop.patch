+    /** 生成带序号的圆点图标（带缓存），起点绿 / 终点红 / 中间蓝 */
+    private BitmapDescriptor routeDotIcon(int index, int total) {
+        String key = (index == 0 ? "s" : (index == total - 1 ? "e" : "n")) + index + "_" + total;
+        BitmapDescriptor cached = mRouteIconCache.get(key);
+        if (cached != null) {
+            return cached;
+        }
+
+        int size = 72;
+        Bitmap bmp = Bitmap.createBitmap(size, size, Bitmap.Config.ARGB_8888);
+        Canvas canvas = new Canvas(bmp);
+
+        Paint paint = new Paint(Paint.ANTI_ALIAS_FLAG);
+        paint.setColor(index == 0 ? 0xFF2E7D32 : (index == total - 1 ? 0xFFC62828 : 0xFF1565C0));
+        canvas.drawCircle(size / 2.0f, size / 2.0f, size / 2.0f - 4, paint);
+
+        Paint ring = new Paint(Paint.ANTI_ALIAS_FLAG);
+        ring.setStyle(Paint.Style.STROKE);
+        ring.setStrokeWidth(4f);
+        ring.setColor(Color.WHITE);
+        canvas.drawCircle(size / 2.0f, size / 2.0f, size / 2.0f - 6, ring);
+
+        Paint text = new Paint(Paint.ANTI_ALIAS_FLAG);
+        text.setColor(Color.WHITE);
+        text.setTextSize(total > 99 ? 30f : 36f);
+        text.setTypeface(Typeface.DEFAULT_BOLD);
+        text.setTextAlign(Paint.Align.CENTER);
+        String label = total > 99 ? "•" : String.valueOf(index + 1);
+        float ty = size / 2.0f - (text.descent() + text.ascent()) / 2.0f;
+        canvas.drawText(label, size / 2.0f, ty, text);
+
+        BitmapDescriptor desc = BitmapDescriptorFactory.fromBitmap(bmp);
+        mRouteIconCache.put(key, desc);
+        return desc;
+    }
+
+    /** 新增路径点：与上一个点距离过近（重叠）时拒绝，避免零长度段 */
+    private void addRoutePoint(LatLng point) {
+        if (!mRoutePoints.isEmpty()
+                && distanceMeterBd(mRoutePoints.get(mRoutePoints.size() - 1), point) < MIN_POINT_GAP_M) {
+            GoUtils.DisplayToast(this, getResources().getString(R.string.route_point_too_close));
+            return;
+        }
+        mRoutePoints.add(point);
+        sanitizeRoute();
+        persistRoute();
+        drawRoute();
+        updateRouteStatus();
+    }
+
+    /** 清理重叠点 / 首尾重复点（续接时顺序保持不变） */
+    private void sanitizeRoute() {
+        List<LatLng> out = new ArrayList<>();
+        for (LatLng p : mRoutePoints) {
+            if (p == null) {
+                continue;
+            }
+            if (!out.isEmpty() && distanceMeterBd(out.get(out.size() - 1), p) < MIN_POINT_GAP_M) {
+                continue;
+            }
+            out.add(p);
+        }
+        while (out.size() > 2 && distanceMeterBd(out.get(0), out.get(out.size() - 1)) < MIN_POINT_GAP_M) {
+            out.remove(out.size() - 1);
+        }
+        if (out.size() != mRoutePoints.size()) {
+            mRoutePoints.clear();
+            mRoutePoints.addAll(out);
+        }
+    }
+
+    private void persistRoute() {
+        List<RoutePath.Point> pts = new ArrayList<>();
+        for (LatLng p : mRoutePoints) {
+            pts.add(new RoutePath.Point(p.longitude, p.latitude, 0.0, 0.0));
+        }
+        sharedPreferences.edit().putString("setting_route_points", RoutePath.encode(pts)).apply();
+    }
+
+    private void startRouteCruise() {
+        if (isRoutePlaying) {
+            stopRouteCruise(false);     // 先停掉上一轮，避免两个播放器叠加
+        }
+
+        sanitizeRoute();
+        if (mRoutePoints.size() < 2) {
+            GoUtils.DisplayToast(this, getResources().getString(R.string.route_need_points));
+            return;
+        }
+
+        if (!GoUtils.isGpsOpened(this)) {
+            GoUtils.showEnableGpsDialog(this);
+            return;
+        }
+
+        if (!Settings.canDrawOverlays(getApplicationContext())) {
+            GoUtils.showEnableFloatWindowDialog(this);
+            return;
+        }
+
+        double speed = 5.0;
+        try {
+            speed = Double.parseDouble(mRouteSpeed.getText().toString().trim());
+        } catch (Exception e) {
+            GoUtils.DisplayToast(this, getResources().getString(R.string.route_invalid_speed));
+        }
+        if (speed < 0.2) {
+            speed = 0.2;
+        }
+        if (speed > 120.0) {
+            speed = 120.0;
+        }
+
+        double accel = 1.2;
+        double terrain = 1.5;
+        double terrainPeriod = 500.0;
+        try {
+            accel = Double.parseDouble(sharedPreferences.getString("setting_route_accel", "1.2"));
+        } catch (Exception ignored) {
+        }
+        try {
+            terrain = Double.parseDouble(sharedPreferences.getString("setting_route_terrain", "1.5"));
