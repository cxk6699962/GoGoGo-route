+    private void updateRouteStatus() {
+        if (mRouteStatus == null) {
+            return;
+        }
+        if (mRoutePoints.isEmpty()) {
+            mRouteStatus.setText(R.string.route_status_empty);
+            return;
+        }
+        double len = 0.0;
+        for (int i = 1; i < mRoutePoints.size(); i++) {
+            len += distanceMeterBd(mRoutePoints.get(i - 1), mRoutePoints.get(i));
+        }
+        mRouteStatus.setText(getString(R.string.route_status_fmt, mRoutePoints.size(), len));
+    }
+
+    /** BD09 两点近似距离（米），仅用于界面显示 */
+    private static double distanceMeterBd(LatLng a, LatLng b) {
+        return RoutePath.distanceMeter(new RoutePath.Point(a.longitude, a.latitude, 0.0, 0.0),
+                new RoutePath.Point(b.longitude, b.latitude, 0.0, 0.0));
+    }
+
+    /**
+     * 重绘路径：先清掉旧的标记点，再按序号重新画圆点（起点绿、终点红、中间蓝），
