<PreferenceScreen xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:android="http://schemas.android.com/apk/res/android"
    app:iconSpaceReserved="false">

    <PreferenceCategory
        app:title="@string/setting_group_move"
        app:iconSpaceReserved="false">
        <ListPreference
            app:key="setting_joystick_type"
            app:title="@string/setting_joystick_type"
            app:entries="@array/array_joystick_type"
            app:entryValues="@array/array_joystick_type_values"
            app:dialogTitle="@string/setting_joystick_type"
            app:defaultValue="0"
            app:iconSpaceReserved="false">
        </ListPreference>

        <EditTextPreference
            app:key="setting_walk"
            app:title="@string/setting_walk"
            app:defaultValue="@string/setting_walk_default"
            app:summary="@string/setting_walk_default"
            app:iconSpaceReserved="false"/>

        <EditTextPreference
            app:key="setting_run"
            app:title="@string/setting_run"
            app:defaultValue="@string/setting_run_default"
            app:summary="@string/setting_run_default"
            app:iconSpaceReserved="false"/>

        <EditTextPreference
            app:key="setting_bike"
            app:title="@string/setting_bike"
            app:defaultValue="@string/setting_bike_default"
            app:summary="@string/setting_bike_default"
            app:iconSpaceReserved="false"/>

        <EditTextPreference
            app:key="setting_altitude"
            app:title="@string/setting_altitude"
            app:defaultValue="@string/setting_altitude_default"
            app:summary="@string/setting_altitude_default"
            app:iconSpaceReserved="false"/>

    </PreferenceCategory>

    <PreferenceCategory
        app:title="@string/setting_group_location_offset"
        app:iconSpaceReserved="false">

        <SwitchPreferenceCompat
            app:key="setting_random_offset"
            app:title="@string/setting_random_offset"
            app:summary="@string/setting_random_offset_summary"
            app:defaultValue="false"
            app:iconSpaceReserved="false"/>
        <EditTextPreference
            app:key="setting_lat_max_offset"
            app:title="@string/setting_lat_max_offset"
            app:defaultValue="@string/setting_random_offset_default"
            app:summary="@string/setting_random_offset_default"
            app:iconSpaceReserved="false"/>
        <EditTextPreference
            app:key="setting_lon_max_offset"
            app:title="@string/setting_lon_max_offset"
            app:defaultValue="@string/setting_random_offset_default"
            app:summary="@string/setting_random_offset_default"
            app:iconSpaceReserved="false"/>
    </PreferenceCategory>

    <PreferenceCategory
        app:title="@string/setting_group_log"
        app:iconSpaceReserved="false">

        <SwitchPreferenceCompat
            app:key="setting_log_off"
            app:title="@string/setting_log_off"
            app:defaultValue="false"
            app:iconSpaceReserved="false"/>
        <EditTextPreference
            app:key="setting_history_expiration"
            app:title="@string/setting_history_expiration"
            app:defaultValue="@string/history_expiration"
            app:summary="@string/history_expiration"
            app:iconSpaceReserved="false"/>
    </PreferenceCategory>

    <PreferenceCategory
        app:title="@string/setting_group_adv_loc"
        app:iconSpaceReserved="false">

        <SwitchPreferenceCompat
            app:key="setting_adv_sim"
            app:title="@string/setting_adv_sim"
            app:summary="@string/setting_adv_sim_summary"
            app:defaultValue="true"
            app:iconSpaceReserved="false"/>

        <EditTextPreference
            app:key="setting_jitter"
            app:title="@string/setting_jitter"
            app:defaultValue="@string/setting_jitter_default"
            app:summary="@string/setting_jitter_default"
            app:iconSpaceReserved="false"/>

        <EditTextPreference
            app:key="setting_satellites"
            app:title="@string/setting_satellites"
            app:defaultValue="@string/setting_satellites_default"
            app:summary="@string/setting_satellites_default"
            app:iconSpaceReserved="false"/>

        <EditTextPreference
            app:key="setting_alt_jitter"
            app:title="@string/setting_alt_jitter"
            app:defaultValue="@string/setting_alt_jitter_default"
            app:summary="@string/setting_alt_jitter_default"
            app:iconSpaceReserved="false"/>
    </PreferenceCategory>

    <PreferenceCategory
        app:title="@string/setting_group_route"
        app:iconSpaceReserved="false">

        <EditTextPreference
            app:key="setting_route_speed"
            app:title="@string/setting_route_speed"
            app:defaultValue="@string/setting_route_speed_default"
            app:summary="@string/setting_route_speed_default"
            app:iconSpaceReserved="false"/>

        <EditTextPreference
            app:key="setting_route_accel"
            app:title="@string/setting_route_accel"
            app:defaultValue="@string/setting_route_accel_default"
            app:summary="@string/setting_route_accel_default"
            app:iconSpaceReserved="false"/>

        <EditTextPreference
            app:key="setting_route_terrain"
            app:title="@string/setting_route_terrain"
            app:defaultValue="@string/setting_route_terrain_default"
            app:summary="@string/setting_route_terrain_default"
            app:iconSpaceReserved="false"/>

        <ListPreference
            app:key="setting_route_mode"
            app:title="@string/setting_route_mode"
            app:entries="@array/array_route_mode"
            app:entryValues="@array/array_route_mode_values"
            app:defaultValue="0"
            app:iconSpaceReserved="false"/>
    </PreferenceCategory>

    <PreferenceCategory
        app:title="@string/setting_group_running"
        app:iconSpaceReserved="false">

        <SwitchPreferenceCompat
            app:key="setting_step_drive"
            app:title="@string/setting_step_drive"
            app:summary="@string/setting_step_drive_summary"
            app:defaultValue="false"
            app:iconSpaceReserved="false"/>

        <EditTextPreference
            app:key="setting_stride"
            app:title="@string/setting_stride"
            app:defaultValue="@string/setting_stride_default"
            app:summary="@string/setting_stride_default"
            app:iconSpaceReserved="false"/>

        <EditTextPreference
            app:key="setting_loop_offset"
            app:title="@string/setting_loop_offset"
            app:summary="@string/setting_loop_offset_summary"
            app:defaultValue="@string/setting_loop_offset_default"
            app:iconSpaceReserved="false"/>

        <EditTextPreference
            app:key="setting_drift"
            app:title="@string/setting_drift"
            app:summary="@string/setting_drift_summary"
            app:defaultValue="@string/setting_drift_default"
            app:iconSpaceReserved="false"/>

        <EditTextPreference
            app:key="setting_net_interval"
            app:title="@string/setting_net_interval"
            app:summary="@string/setting_net_interval_summary"
            app:defaultValue="@string/setting_net_interval_default"
            app:iconSpaceReserved="false"/>
    </PreferenceCategory>

    <PreferenceCategory
        app:title="@string/setting_group_about"
        app:iconSpaceReserved="false">

        <Preference
            app:key="setting_version"
            app:title="@string/setting_version"
            app:iconSpaceReserved="false"/>

        <Preference
            app:key="setting_author"
            app:title="@string/setting_author"
            app:defaultValue="@string/app_author"
            app:summary="@string/app_author"
            app:iconSpaceReserved="false"/>
    </PreferenceCategory>
</PreferenceScreen>